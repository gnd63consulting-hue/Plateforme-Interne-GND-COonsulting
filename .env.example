# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# App
NEXT_PUBLIC_APP_URL=https://formation.gndconsulting.fr

# Notion → Prospects sync (POST /api/admin/sync-prospects)
# Génère un secret long + random pour sécuriser l'endpoint de sync.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PROSPECTS_DB_ID=cc69ef03-abfa-487e-b392-0f308a30f404
ADMIN_SYNC_SECRET=replace-with-a-long-random-string

# Vercel Cron auto-sync (GET /api/admin/sync-prospects every 6h, see vercel.json)
# Vercel injecte automatiquement `Authorization: Bearer ${CRON_SECRET}` à chaque
# exécution du cron. À définir uniquement dans les env vars Vercel (Production +
# Preview), pas dans .env.local. Voir https://vercel.com/docs/cron-jobs#securing-cron-jobs
CRON_SECRET=replace-with-another-long-random-string

# Stripe (Sprint 11 — mode TEST)
# STRIPE_SECRET_KEY : SERVER ONLY (jamais prefixe NEXT_PUBLIC_). Lu par src/lib/stripe.ts.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY : exposable cote client.
# STRIPE_WEBHOOK_SECRET : SERVER ONLY. Signing secret du webhook, genere quand on
#   cree l'endpoint /api/stripe/webhook dans le dashboard Stripe.
# A definir UNIQUEMENT dans les env vars Vercel (Production + Preview + Development),
# jamais en dur dans le code ni dans la base.
STRIPE_SECRET_KEY=<cle_secrete_stripe_test>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<cle_publishable_stripe_test>
STRIPE_WEBHOOK_SECRET=<signing_secret_du_webhook_stripe>

# --- Digest email du matin (Sprint 19) — OPTIONNEL, server-only ---
# Sans RESEND_API_KEY, la route /api/notifications/digest reste DORMANTE (no-op).
# Cle API Resend (https://resend.com) — JAMAIS cote client, env Vercel uniquement.
RESEND_API_KEY=<cle_api_resend>
# Expediteur verifie dans Resend (domaine DNS valide), ex : "GND CRM <notifications@gndconsulting.fr>"
RESEND_FROM=<expediteur_verifie>
